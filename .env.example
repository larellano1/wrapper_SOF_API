# Configuração da API SOF (APILIB - Prefeitura de São Paulo)
# Cadastro: https://apilib.prefeitura.sp.gov.br/store/
#
# Copie este arquivo para `.env` e preencha os valores.

# === Modo recomendado: OAuth2 client credentials (refresh automático) ===
# Pegue do "Sandbox Keys" ou "Production Keys" da sua aplicação no APILIB
SOF_API_CONSUMER_KEY=
SOF_API_CONSUMER_SECRET=

# === Alternativa: token estático colado (expira em ~1h) ===
# Se preencher SOF_API_TOKEN, ele é usado e os campos acima são ignorados.
# SOF_API_TOKEN=

# === Opcionais ===
# SOF_API_BASE_URL=https://gateway.apilib.prefeitura.sp.gov.br/sf/sof/v4
# SOF_API_TOKEN_URL=https://gateway.apilib.prefeitura.sp.gov.br/token
# SOF_API_VERIFY_SSL=true
